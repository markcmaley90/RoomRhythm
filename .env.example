# Optional: where "Suggest a Feature" submissions are POSTed.
# Set this to a form-collection URL (e.g. a Formspree endpoint like
# https://formspree.io/f/xxxxxxx) to capture feedback server-side.
# When unset, the form falls back to opening the visitor's email client.
NEXT_PUBLIC_FEEDBACK_ENDPOINT=

# Public site origin, used for metadataBase, sitemap.xml, and robots.txt URLs.
# MUST be set to the production origin (e.g. https://roomrhythm.com) before launch —
# without it, absolute URLs fall back to http://localhost:3001.
NEXT_PUBLIC_SITE_URL=

# Plausible analytics domain (cookieless, no consent banner needed) — e.g.
# roomrhythm.app. Leave UNSET to disable analytics entirely: no script tag is
# rendered and no network request is made, which is what local dev should do.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Pinterest site-claim token. Pinterest gives you this when you claim the domain
# (Settings -> Claimed accounts -> Websites -> Claim -> "Add HTML tag"). Paste ONLY
# the content value, not the whole <meta> tag. Claiming attributes every pin from
# this site to our profile and unlocks pin analytics. Leave UNSET before launch —
# no meta tag is emitted. See docs/gtm-social-profiles.md.
NEXT_PUBLIC_PINTEREST_VERIFY=
